# Copy to .env and adjust. Every setting is documented in docs/configuration.md.

# --- production (compose.prod.yaml) ---
PCBIS_DOMAIN=inspect.example.com
PCBIS_VERSION=latest
POSTGRES_PASSWORD=change-me

# --- web console at /ui (disabled when empty); generate: python -c "import secrets;print(secrets.token_urlsafe(18))"
PCBIS_UI_PASSWORD=
PCBIS_UI_SESSION_HOURS=12

# --- service ---
PCBIS_LOG_LEVEL=INFO
PCBIS_LOG_FORMAT=json
PCBIS_MAX_UPLOAD_MB=25
PCBIS_TASK_TIME_LIMIT_S=120
PCBIS_WORKER_CONCURRENCY=2
PCBIS_API_WORKERS=2

# --- storage: local (default) or s3 ---
PCBIS_STORAGE_BACKEND=local
# PCBIS_S3_ENDPOINT=http://minio:9000
# PCBIS_S3_BUCKET=pcbis
# PCBIS_S3_ACCESS_KEY=
# PCBIS_S3_SECRET_KEY=

# --- algorithm defaults (calibrate on your boards, see docs/algorithm.md) ---
PCBIS_ENGINE_WORK_WIDTH=3000
PCBIS_ENGINE_THRESHOLD=12.0
PCBIS_ENGINE_MIN_AREA=40
PCBIS_DEFAULT_MASK_STRATEGY=full_frame
PCBIS_GATE_MIN_SHARPNESS_RATIO=0.90
PCBIS_GATE_MAX_DIFFERENCES=60
